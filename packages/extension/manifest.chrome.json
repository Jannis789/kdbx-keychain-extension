{
  "manifest_version": 3,
  "name": "KDBX Keychain",
  "description": "KDBX-Passwort-Manager mit Dropbox-Sync, TOTP und Auto-Fill. GNOME-inspiriertes Design.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "KDBX Keychain",
    "default_popup": "popup/index.html"
  },
  "options_ui": { "page": "options/index.html", "open_in_tab": true },
  "storage": { "managed_schema": "managed-schema.json" },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "clipboardRead",
    "nativeMessaging",
    "identity",
    "offscreen",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-current-tab": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Eintrag für aktuelle Seite suchen und ausfüllen"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
